var previous = UnityEngine.SceneManagement.SceneManager.GetActiveScene();
var scene = UnityEditor.SceneManagement.EditorSceneManager.NewPreviewScene();
var cameraObject = new GameObject("URP shader probe");
UnityEngine.SceneManagement.SceneManager.MoveGameObjectToScene(cameraObject, scene);
var camera = cameraObject.AddComponent<Camera>();
camera.scene = scene;
camera.transform.position = new Vector3(0,0,-3);
camera.orthographic = true;
camera.orthographicSize = 1;
camera.clearFlags = CameraClearFlags.SolidColor;
camera.backgroundColor = Color.blue;
camera.enabled = false;
var target = new RenderTexture(128,128,24);
camera.targetTexture = target;
var obj = GameObject.CreatePrimitive(PrimitiveType.Cube);
UnityEngine.SceneManagement.SceneManager.MoveGameObjectToScene(obj, scene);
var mat = new Material(Shader.Find("DissolverShader/DissolveShader"));
mat.SetTexture("_DissolveMap", Texture2D.grayTexture);
mat.SetTexture("_MainTex", Texture2D.whiteTexture);
mat.SetColor("_Color", Color.white);
obj.GetComponent<Renderer>().sharedMaterial = mat;
var pixels = new Texture2D(128,128,TextureFormat.RGB24,false);
var counts = new System.Collections.Generic.List<int>();
var oldTarget = RenderTexture.active;
foreach (float amount in new float[] { 0, 1 }) {
 mat.SetFloat("_DissolveAmount", amount);
 camera.Render();
 RenderTexture.active = target;
 pixels.ReadPixels(new Rect(0,0,128,128),0,0);
 pixels.Apply();
 int changed = 0;
 foreach (var c in pixels.GetPixels()) if (c.b < 0.8f || c.r > 0.1f || c.g > 0.1f) changed++;
 counts.Add(changed);
}
// Render a simple outlined object with the same separately queued materials as QuickOutline.
var baseMat = new Material(Shader.Find("Universal Render Pipeline/Unlit"));
baseMat.SetColor("_BaseColor", Color.green);
var mask = new Material(Shader.Find("Custom/Outline Mask"));
var fill = new Material(Shader.Find("Custom/Outline Fill"));
mask.SetFloat("_ZTest", 8);
fill.SetFloat("_ZTest", 8);
fill.SetColor("_OutlineColor", Color.red);
fill.SetFloat("_OutlineWidth", 10);
obj.GetComponent<Renderer>().sharedMaterials = new Material[] { baseMat, mask, fill };
camera.Render();
RenderTexture.active = target;
pixels.ReadPixels(new Rect(0,0,128,128),0,0);
pixels.Apply();
int outlinePixels = 0;
foreach (var c in pixels.GetPixels()) if (c.r > 0.5f && c.g < 0.2f && c.b < 0.2f) outlinePixels++;
System.IO.File.WriteAllBytes("Logs/urp-outline-probe.png", pixels.EncodeToPNG());
UnityEngine.Object.DestroyImmediate(baseMat);
UnityEngine.Object.DestroyImmediate(mask);
UnityEngine.Object.DestroyImmediate(fill);
RenderTexture.active = oldTarget;
camera.targetTexture = null;
UnityEngine.Object.DestroyImmediate(pixels);
UnityEngine.Object.DestroyImmediate(mat);
UnityEngine.Object.DestroyImmediate(target);
UnityEditor.SceneManagement.EditorSceneManager.ClosePreviewScene(scene);
if (previous.IsValid()) UnityEngine.SceneManagement.SceneManager.SetActiveScene(previous);
return new { visiblePixels = counts[0], dissolvedPixels = counts[1], outlinePixels = outlinePixels, passed = counts[0] > 500 && counts[1] == 0 && outlinePixels > 20 };
